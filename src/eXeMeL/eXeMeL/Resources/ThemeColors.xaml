<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  >

  <!-- Theme marker for runtime dictionary swap -->
  <sys:Boolean x:Key="IsEXeMeLTheme">True</sys:Boolean>

  <!-- Base colors -->
  <Color x:Key="BlackColor">#FF252525</Color>
  <Color x:Key="WhiteColor">#FFEDEDED</Color>

  <!-- Core brushes still referenced by views -->
  <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
  <SolidColorBrush x:Key="LabelTextBrush" Color="{StaticResource BlackColor}" />

  <!-- Chrome tint (transparent for non-tinted themes) -->
  <SolidColorBrush x:Key="ChromeTintOverlayBrush" Color="Transparent"/>
  <SolidColorBrush x:Key="EditorTintOverlayBrush" Color="#FFEDEDED"/>
  <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#FFF0F0F0"/>
  <SolidColorBrush x:Key="AppTextBrush" Color="#252525"/>
  <SolidColorBrush x:Key="AppAccentBrush" Color="#D4AA00"/>

  <!-- AvalonEdit editor content foreground -->
  <Color x:Key="Gray1">#FF333333</Color>
  <SolidColorBrush x:Key="EditorTextBrush" Color="{DynamicResource Gray1}"/>

</ResourceDictionary>
