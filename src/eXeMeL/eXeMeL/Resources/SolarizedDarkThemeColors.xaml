<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  >

  <!-- Theme marker for runtime dictionary swap -->
  <sys:Boolean x:Key="IsEXeMeLTheme">True</sys:Boolean>

  <!-- Base colors (Solarized dark palette) -->
  <Color x:Key="BlackColor">#FFFFFFFF</Color>
  <Color x:Key="WhiteColor">#002b36</Color>

  <!-- Core brushes still referenced by views -->
  <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
  <SolidColorBrush x:Key="LabelTextBrush" Color="{StaticResource BlackColor}" />

  <!-- Chrome tint (transparent for non-tinted themes) -->
  <SolidColorBrush x:Key="ChromeTintOverlayBrush" Color="Transparent"/>

  <!-- AvalonEdit editor content foreground -->
  <Color x:Key="Gray7">#FF7E7E7E</Color>
  <SolidColorBrush x:Key="EditorTextBrush" Color="{DynamicResource Gray7}"/>

</ResourceDictionary>
