<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  >

  <sys:Boolean x:Key="IsEXeMeLTheme">True</sys:Boolean>

  <Color x:Key="BlackColor">#FF252525</Color>
  <Color x:Key="WhiteColor">#FFEDEDED</Color>

  <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
  <SolidColorBrush x:Key="LabelTextBrush" Color="{StaticResource BlackColor}" />

  <!-- Glass: semi-transparent chrome tint (will be overridden at runtime with user color) -->
  <SolidColorBrush x:Key="ChromeTintOverlayBrush" Color="#20000000"/>
  <SolidColorBrush x:Key="EditorTintOverlayBrush" Color="#10000000"/>
  <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#FFF0F0F0"/>

  <Color x:Key="Gray1">#FF333333</Color>
  <SolidColorBrush x:Key="EditorTextBrush" Color="{DynamicResource Gray1}"/>

</ResourceDictionary>
