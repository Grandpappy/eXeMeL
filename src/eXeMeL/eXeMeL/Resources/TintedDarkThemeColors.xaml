<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  >

  <sys:Boolean x:Key="IsEXeMeLTheme">True</sys:Boolean>

  <Color x:Key="BlackColor">#FFFFFFFF</Color>
  <Color x:Key="WhiteColor">#FF1E1E1E</Color>

  <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
  <SolidColorBrush x:Key="LabelTextBrush" Color="{StaticResource BlackColor}" />

  <!-- Tinted: opaque chrome tint (will be overridden at runtime with user color) -->
  <SolidColorBrush x:Key="ChromeTintOverlayBrush" Color="#CC3366CC"/>
  <SolidColorBrush x:Key="EditorTintOverlayBrush" Color="#403366CC"/>

  <Color x:Key="Gray7">#FF7E7E7E</Color>
  <SolidColorBrush x:Key="EditorTextBrush" Color="{DynamicResource Gray7}"/>

</ResourceDictionary>
