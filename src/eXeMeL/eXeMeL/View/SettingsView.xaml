<UserControl
  x:Class="eXeMeL.View.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:local="clr-namespace:eXeMeL.View"
  xmlns:views="clr-namespace:eXeMeL.View"
  xmlns:model="clr-namespace:eXeMeL.Model"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="600" d:DesignWidth="350"
  d:DataContext="{d:DesignInstance model:Settings}"
  Width="350"
  Name="ControlRoot">

  <StackPanel Margin="16,8,16,0">

    <!-- ═══════════════ EDITOR ═══════════════ -->
    <TextBlock Text="Editor" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Opacity="0.7"/>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="Line Numbers" FontSize="14"/>
          <TextBlock Text="Show line numbers in the editor" FontSize="12" Opacity="0.5"/>
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding ShowEditorLineNumbers}"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="Word Wrap" FontSize="14"/>
          <TextBlock Text="Wrap long lines in the editor" FontSize="12" Opacity="0.5"/>
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding WrapEditorText}"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="Highlight Selection" FontSize="14"/>
          <TextBlock Text="Highlight all instances of selected text" FontSize="12" Opacity="0.5"/>
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding HighlightOtherInstancesOfSelection}"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="Current Line Highlight" FontSize="14"/>
          <TextBlock Text="Highlight the line the cursor is on" FontSize="12" Opacity="0.5"/>
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding HighlightCurrentLine}"/>
    </ui:CardControl>



    <!-- ═══════════════ THEME &amp; FONTS ═══════════════ -->
    <TextBlock Text="Theme &amp; Fonts" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" Opacity="0.7"/>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <TextBlock Text="Theme" FontSize="14"/>
      </ui:CardControl.Header>
      <ComboBox
        ItemsSource="{Binding Source={local:Enumeration {x:Type model:ApplicationTheme}}}"
        DisplayMemberPath="Description"
        SelectedValue="{Binding ApplicationTheme}"
        SelectedValuePath="Value"
        MinWidth="140"/>
    </ui:CardControl>

    <!-- Glass/Tinted: tint color + window opacity -->
    <StackPanel x:Name="TintSettingsPanel">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding ApplicationTheme}" Value="Glass">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ApplicationTheme}" Value="Tinted">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

      <ui:CardControl Margin="0,0,0,4">
        <ui:CardControl.Header>
          <TextBlock Text="Window Opacity" FontSize="14"/>
        </ui:CardControl.Header>
        <Slider Value="{Binding ChromeOpacity}" Minimum="0" Maximum="1"
                Width="140" VerticalAlignment="Center" Focusable="False"
                SmallChange="0.05" LargeChange="0.1"/>
      </ui:CardControl>
    </StackPanel>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <TextBlock Text="Syntax Highlighting" FontSize="14"/>
      </ui:CardControl.Header>
      <ComboBox
        ItemsSource="{Binding Source={local:Enumeration {x:Type model:SyntaxHighlightingStyle}}}"
        DisplayMemberPath="Description"
        SelectedValue="{Binding SyntaxHighlightingStyle}"
        SelectedValuePath="Value"
        MinWidth="140"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <TextBlock Text="Font Family" FontSize="14"/>
      </ui:CardControl.Header>
      <ComboBox
        ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}"
        SelectedValue="{Binding FontFamily}"
        SelectedValuePath="Source"
        MinWidth="140"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <TextBlock Text="Font Size" FontSize="14"/>
      </ui:CardControl.Header>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Slider Value="{Binding EditorFontSize}" Minimum="12" Maximum="30"
                Width="120" VerticalAlignment="Center" Focusable="False"/>
        <ui:Button Content="Reset" Click="ResetFontSizeButton_Click"
                   Appearance="Transparent" Padding="6,2" Margin="8,0,0,0"
                   VerticalAlignment="Center" FontSize="12"/>
      </StackPanel>
    </ui:CardControl>


    <!-- ═══════════════ COLORS ═══════════════ -->
    <TextBlock Text="Colors" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" Opacity="0.7"/>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <TextBlock Text="Text Color" FontSize="14"/>
      </ui:CardControl.Header>
      <views:ColorPickerPopup SelectedColor="{Binding TextColor, Mode=TwoWay}"
                               SwatchColors="{x:Static views:ColorSwatches.TextColors}"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <TextBlock Text="Accent Color" FontSize="14"/>
      </ui:CardControl.Header>
      <views:ColorPickerPopup SelectedColor="{Binding AccentColor, Mode=TwoWay}"
                               SwatchColors="{x:Static views:ColorSwatches.AccentColors}"/>
    </ui:CardControl>

    <!-- Application Color (tint) — visible only for Glass/Tinted themes -->
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding ApplicationTheme}" Value="Glass">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ApplicationTheme}" Value="Tinted">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <ui:CardControl Margin="0,0,0,4">
        <ui:CardControl.Header>
          <TextBlock Text="Application Color" FontSize="14"/>
        </ui:CardControl.Header>
        <views:ColorPickerPopup SelectedColor="{Binding ChromeTintColor, Mode=TwoWay}"
                                 SwatchColors="{x:Static views:ColorSwatches.TintColors}"/>
      </ui:CardControl>
    </StackPanel>

    <!-- Editor Background: link/unlink + color picker -->
    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="Editor Background" FontSize="14"/>
          <TextBlock x:Name="EditorBackgroundSubtext" Text="Follows theme" FontSize="12" Opacity="0.5"/>
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel Orientation="Horizontal">
        <ui:Button x:Name="EditorBackgroundLinkButton"
                   Click="EditorBackgroundLinkButton_Click"
                   Appearance="Transparent" Padding="4" Margin="0,0,4,0"
                   ToolTip="Link/unlink from theme" Focusable="False">
          <ui:SymbolIcon x:Name="EditorBackgroundLinkIcon" Symbol="Link24" FontSize="16"/>
        </ui:Button>
        <views:ColorPickerPopup x:Name="EditorBackgroundColorPicker"
                                 SwatchColors="{x:Static views:ColorSwatches.EditorBackgroundColors}"
                                 IsEnabled="False"/>
      </StackPanel>
    </ui:CardControl>

    <!-- Editor Opacity — always visible -->
    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <TextBlock Text="Editor Opacity" FontSize="14"/>
      </ui:CardControl.Header>
      <Slider Value="{Binding EditorTintIntensity}" Minimum="0" Maximum="1"
              Width="140" VerticalAlignment="Center" Focusable="False"
              SmallChange="0.05" LargeChange="0.1"/>
    </ui:CardControl>


    <!-- Reset -->
    <ui:Button Content="Reset All to Defaults" Click="ResetToDefaultsButton_Click"
               Margin="0,20,0,0" HorizontalAlignment="Left" Appearance="Caution"/>

    <!-- About -->
    <TextBlock Text="About" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" Opacity="0.7"/>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="eXeMeL" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CurrentVersion, ElementName=ControlRoot, StringFormat='Version {0}'}"
                     FontSize="12" Opacity="0.5"/>
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button Content="Check for Updates" Click="CheckForUpdatesButton_Click"
                 Appearance="Primary" Padding="12,6"/>
    </ui:CardControl>

    <TextBlock Margin="8,8,0,0" FontSize="12" Opacity="0.5" TextWrapping="Wrap">
      <Run Text="Built with AvalonEdit, CommunityToolkit.Mvvm, WPF-UI"/>
    </TextBlock>

  </StackPanel>
</UserControl>
