<UserControl
  x:Class="eXeMeL.View.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:local="clr-namespace:eXeMeL.View"
  xmlns:views="clr-namespace:eXeMeL.View"
  xmlns:model="clr-namespace:eXeMeL.Model"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="600" d:DesignWidth="350"
  d:DataContext="{d:DesignInstance model:Settings}"
  Width="350"
  Name="ControlRoot">

  <StackPanel Margin="16,8,16,0">

    <!-- Editor Settings -->
    <TextBlock Text="Editor" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" Opacity="0.7"/>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="Line Numbers" FontSize="14"/>
          <TextBlock Text="Show line numbers in the editor" FontSize="12" Opacity="0.5"/>
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding ShowEditorLineNumbers}"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="Word Wrap" FontSize="14"/>
          <TextBlock Text="Wrap long lines in the editor" FontSize="12" Opacity="0.5"/>
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding WrapEditorText}"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="Highlight Selection" FontSize="14"/>
          <TextBlock Text="Highlight all instances of selected text" FontSize="12" Opacity="0.5"/>
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding HighlightOtherInstancesOfSelection}"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="Font Size" FontSize="14"/>
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Slider Value="{Binding EditorFontSize}" Minimum="12" Maximum="30"
                Width="120" VerticalAlignment="Center" Focusable="False"/>
        <ui:Button Content="Reset" Click="ResetFontSizeButton_Click"
                   Appearance="Transparent" Padding="6,2" Margin="8,0,0,0"
                   VerticalAlignment="Center" FontSize="12"/>
      </StackPanel>
    </ui:CardControl>


    <!-- Appearance -->
    <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" Opacity="0.7"/>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <TextBlock Text="Theme" FontSize="14"/>
      </ui:CardControl.Header>
      <ComboBox
        ItemsSource="{Binding Source={local:Enumeration {x:Type model:ApplicationTheme}}}"
        DisplayMemberPath="Description"
        SelectedValue="{Binding ApplicationTheme}"
        SelectedValuePath="Value"
        MinWidth="140"/>
    </ui:CardControl>

    <!-- Chrome tint color picker (visible only for glass/tinted themes) -->
    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Style>
        <Style TargetType="ui:CardControl">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding ApplicationTheme}" Value="GlassLight">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ApplicationTheme}" Value="GlassDark">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ApplicationTheme}" Value="TintedLight">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ApplicationTheme}" Value="TintedDark">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ui:CardControl.Style>
      <ui:CardControl.Header>
        <TextBlock Text="Chrome Tint" FontSize="14"/>
      </ui:CardControl.Header>
      <views:ColorPickerControl SelectedColor="{Binding ChromeTintColor, Mode=TwoWay}"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <TextBlock Text="Syntax Highlighting" FontSize="14"/>
      </ui:CardControl.Header>
      <ComboBox
        ItemsSource="{Binding Source={local:Enumeration {x:Type model:SyntaxHighlightingStyle}}}"
        DisplayMemberPath="Description"
        SelectedValue="{Binding SyntaxHighlightingStyle}"
        SelectedValuePath="Value"
        MinWidth="140"/>
    </ui:CardControl>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <TextBlock Text="Font Family" FontSize="14"/>
      </ui:CardControl.Header>
      <ComboBox
        ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}"
        SelectedValue="{Binding FontFamily}"
        SelectedValuePath="Source"
        MinWidth="140"/>
    </ui:CardControl>


    <!-- About -->
    <TextBlock Text="About" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" Opacity="0.7"/>

    <ui:CardControl Margin="0,0,0,4">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Text="eXeMeL" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CurrentVersion, ElementName=ControlRoot, StringFormat='Version {0}'}"
                     FontSize="12" Opacity="0.5"/>
        </StackPanel>
      </ui:CardControl.Header>
    </ui:CardControl>

    <TextBlock Margin="8,8,0,0" FontSize="12" Opacity="0.5" TextWrapping="Wrap">
      <Run Text="Built with AvalonEdit, CommunityToolkit.Mvvm, WPF-UI"/>
    </TextBlock>

  </StackPanel>
</UserControl>
