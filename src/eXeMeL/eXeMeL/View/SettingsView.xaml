<UserControl
  x:Class="eXeMeL.View.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:eXeMeL.View"
  xmlns:model="clr-namespace:eXeMeL.Model"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  mc:Ignorable="d"
  d:DesignHeight="600" d:DesignWidth="360"
  d:DataContext="{d:DesignInstance model:Settings}"
  Width="360"
  Name="ControlRoot">

  <UserControl.Resources>
    <Style x:Key="SettingGroupHeaderStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource FlyoutForegroundBrush}"/>
      <Setter Property="Opacity" Value="0.7"/>
      <Setter Property="Margin" Value="16,16,16,8"/>
    </Style>
    <Style x:Key="SettingCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource GrayBrush10}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="16,2"/>
    </Style>
    <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource FlyoutForegroundBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource FlyoutForegroundBrush}"/>
      <Setter Property="Opacity" Value="0.6"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Padding="0"
                TextElement.Foreground="{DynamicResource FlyoutForegroundBrush}">
    <StackPanel>

      <!-- Editor Settings Group -->
      <TextBlock Text="EDITOR" Style="{StaticResource SettingGroupHeaderStyle}"/>

      <!-- Line Numbers Toggle -->
      <Border Style="{StaticResource SettingCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Line Numbers" Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Text="Show line numbers in the editor" Style="{StaticResource SettingDescriptionStyle}"/>
          </StackPanel>
          <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowEditorLineNumbers}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Wrap Text Toggle -->
      <Border Style="{StaticResource SettingCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Wrap Text" Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Text="Wrap long lines in the editor" Style="{StaticResource SettingDescriptionStyle}"/>
          </StackPanel>
          <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding WrapEditorText}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Highlight Selection Toggle -->
      <Border Style="{StaticResource SettingCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Highlight Selection" Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Text="Highlight all instances of selected text" Style="{StaticResource SettingDescriptionStyle}"/>
          </StackPanel>
          <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding HighlightOtherInstancesOfSelection}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Font Size -->
      <Border Style="{StaticResource SettingCardStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Font Size" Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{Binding EditorFontSize, StringFormat='{}{0:F0}'}" Style="{StaticResource SettingLabelStyle}" Opacity="0.6"/>
          </Grid>
          <Slider Value="{Binding EditorFontSize}" Minimum="12" Maximum="30" Focusable="False" Margin="0,8,0,4"/>
          <ui:Button Content="Reset" HorizontalAlignment="Right" Click="ResetFontSizeButton_Click" Appearance="Secondary" Padding="12,4" FontSize="12"/>
        </StackPanel>
      </Border>

      <!-- Appearance Group -->
      <TextBlock Text="APPEARANCE" Style="{StaticResource SettingGroupHeaderStyle}"/>

      <!-- Application Theme -->
      <Border Style="{StaticResource SettingCardStyle}">
        <StackPanel>
          <TextBlock Text="Application Theme" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,8"/>
          <ComboBox
            ItemsSource="{Binding Source={local:Enumeration {x:Type model:ApplicationTheme}}}"
            DisplayMemberPath="Description"
            SelectedValue="{Binding ApplicationTheme}"
            SelectedValuePath="Value"
            FontSize="14"
            Foreground="{DynamicResource FlyoutForegroundBrush}"/>
        </StackPanel>
      </Border>

      <!-- Syntax Highlighting -->
      <Border Style="{StaticResource SettingCardStyle}">
        <StackPanel>
          <TextBlock Text="Syntax Highlighting" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,8"/>
          <ComboBox
            ItemsSource="{Binding Source={local:Enumeration {x:Type model:SyntaxHighlightingStyle}}}"
            DisplayMemberPath="Description"
            SelectedValue="{Binding SyntaxHighlightingStyle}"
            SelectedValuePath="Value"
            FontSize="14"
            Foreground="{DynamicResource FlyoutForegroundBrush}"/>
        </StackPanel>
      </Border>

      <!-- Font Family -->
      <Border Style="{StaticResource SettingCardStyle}">
        <StackPanel>
          <TextBlock Text="Font Family" Style="{StaticResource SettingLabelStyle}" Margin="0,0,0,8"/>
          <ComboBox
            ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}"
            SelectedValue="{Binding FontFamily}"
            SelectedValuePath="Source"
            FontSize="14"
            Foreground="{DynamicResource FlyoutForegroundBrush}"/>
        </StackPanel>
      </Border>

      <!-- About Group -->
      <TextBlock Text="ABOUT" Style="{StaticResource SettingGroupHeaderStyle}"/>

      <Border Style="{StaticResource SettingCardStyle}">
        <StackPanel>
          <TextBlock
            Text="{Binding CurrentVersion, ElementName=ControlRoot, StringFormat='Version {0}'}"
            Style="{StaticResource SettingLabelStyle}"
            Margin="0,0,0,8"/>
          <TextBlock Style="{StaticResource SettingDescriptionStyle}" TextWrapping="Wrap">
            <Run Text="Built with AvalonEdit, CommunityToolkit.Mvvm, WPF UI, and ModernUIIcons"/>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Bottom spacing -->
      <Border Height="16"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
