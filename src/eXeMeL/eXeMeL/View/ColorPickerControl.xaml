<UserControl x:Class="eXeMeL.View.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="320" d:DesignHeight="200">

  <StackPanel>
    <!-- Dark preset palette -->
    <TextBlock Text="Dark" FontSize="11" Opacity="0.5" Margin="0,0,0,2"/>
    <WrapPanel x:Name="DarkSwatchPanel" Margin="0,0,0,4"/>

    <!-- Light preset palette -->
    <TextBlock Text="Light" FontSize="11" Opacity="0.5" Margin="0,4,0,2"/>
    <WrapPanel x:Name="LightSwatchPanel" Margin="0,0,0,6"/>

    <!-- HSV interactive picker -->
    <Border CornerRadius="4" Padding="8" Margin="0,4,0,0"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="50"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>

        <!-- Hue slider -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Hue" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
        <Slider x:Name="HueSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="360"
                Value="210" Margin="4,0" ValueChanged="HsvSlider_ValueChanged"/>

        <!-- Saturation slider -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sat" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="0,4,0,0"/>
        <Slider x:Name="SatSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100"
                Value="60" Margin="4,4,4,0" ValueChanged="HsvSlider_ValueChanged"/>

        <!-- Value/Brightness slider -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bright" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="0,4,0,0"/>
        <Slider x:Name="ValSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100"
                Value="80" Margin="4,4,4,0" ValueChanged="HsvSlider_ValueChanged"/>

        <!-- Color preview -->
        <Border x:Name="ColorPreview" Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                Width="24" Height="50" Margin="4,0,0,0"
                CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>

        <!-- Hex input -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Hex:" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBox x:Name="HexInput" Width="80" FontSize="11"
                   Text="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=LostFocus}"
                   VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
