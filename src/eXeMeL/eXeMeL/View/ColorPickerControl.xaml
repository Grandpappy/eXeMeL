<UserControl x:Class="eXeMeL.View.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="320" d:DesignHeight="100">

  <StackPanel>
    <!-- Preset color swatches -->
    <WrapPanel x:Name="SwatchPanel" Margin="0,4,0,4"/>

    <!-- Custom color input -->
    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
      <TextBlock Text="Custom:" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,0,8,0"/>
      <TextBox x:Name="HexInput" Width="80" FontSize="12"
               Text="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=LostFocus}"
               VerticalAlignment="Center"/>
      <Border x:Name="ColorPreview" Width="20" Height="20" Margin="8,0,0,0"
              CornerRadius="3" BorderThickness="1"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
