<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:vm="clr-namespace:eXeMeL.ViewModel.JsonUtility"
  x:Class="eXeMeL.View.JsonUtilityView"
  mc:Ignorable="d"
  Name="ControlRoot"
  d:DesignHeight="300" d:DesignWidth="400"
  d:DataContext="{d:DesignInstance vm:JsonUtilityViewModel}"
  >

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <Style x:Key="JsonText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{Binding ElementName=ControlRoot, Path=Settings.EditorFontSize}"/>
      <Setter Property="FontFamily" Value="{Binding ElementName=ControlRoot, Path=Settings.FontFamily}"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- TreeViewItem: bind IsExpanded, minimal chrome -->
    <Style TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <StackPanel>
              <ContentPresenter ContentSource="Header"/>
              <ItemsPresenter x:Name="ItemsHost"
                              Margin="20,0,0,0"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- JSON node template -->
    <HierarchicalDataTemplate DataType="{x:Type vm:JsonNodeViewModel}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Cursor="Hand"
                  MouseLeftButtonDown="NodeHeader_MouseLeftButtonDown">
        <StackPanel.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Expand all" Command="{Binding ExpandAllCommand}"/>
            <MenuItem Header="Collapse all" Command="{Binding CollapseAllCommand}"/>
          </ContextMenu>
        </StackPanel.ContextMenu>

        <!-- Property name -->
        <TextBlock Text="{Binding Name, StringFormat='\{0}': }" Style="{StaticResource JsonText}"
                   Foreground="{Binding ElementName=ControlRoot, Path=Settings.ElementBrush}"
                   Visibility="{Binding Name, TargetNullValue=Collapsed, FallbackValue=Visible}"/>

        <!-- Value display depends on node type -->
        <TextBlock x:Name="ValueText" Text="{Binding Value}" Style="{StaticResource JsonText}"
                   Foreground="{Binding ElementName=ControlRoot, Path=Settings.AttributeValueBrush}"/>

        <!-- Object/Array summary when collapsed -->
        <TextBlock x:Name="ObjectSummary" Style="{StaticResource JsonText}" Opacity="0.5" Margin="2,0,0,0"/>
      </StackPanel>

      <HierarchicalDataTemplate.Triggers>
        <!-- String values: show quoted in attribute value color -->
        <DataTrigger Binding="{Binding NodeType}" Value="String">
          <Setter TargetName="ValueText" Property="Text" Value="{Binding Value, StringFormat='&quot;\{0}&quot;'}"/>
        </DataTrigger>

        <!-- Boolean/Null: show in element color (keyword-style) -->
        <DataTrigger Binding="{Binding NodeType}" Value="Boolean">
          <Setter TargetName="ValueText" Property="Foreground" Value="{Binding ElementName=ControlRoot, Path=Settings.ElementBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding NodeType}" Value="Null">
          <Setter TargetName="ValueText" Property="Foreground" Value="{Binding ElementName=ControlRoot, Path=Settings.ElementBrush}"/>
          <Setter TargetName="ValueText" Property="Text" Value="null"/>
        </DataTrigger>

        <!-- Number: show in attribute name color -->
        <DataTrigger Binding="{Binding NodeType}" Value="Number">
          <Setter TargetName="ValueText" Property="Foreground" Value="{Binding ElementName=ControlRoot, Path=Settings.AttributeNameBrush}"/>
        </DataTrigger>

        <!-- Object: show { count } -->
        <DataTrigger Binding="{Binding NodeType}" Value="Object">
          <Setter TargetName="ValueText" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="ObjectSummary" Property="Text" Value="{Binding ChildCount, StringFormat='\{ {0} \}'}"/>
        </DataTrigger>

        <!-- Array: show [ count ] -->
        <DataTrigger Binding="{Binding NodeType}" Value="Array">
          <Setter TargetName="ValueText" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="ObjectSummary" Property="Text" Value="{Binding ChildCount, StringFormat='[ {0} ]'}"/>
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- Valid JSON tree -->
    <TreeView x:Name="JsonTree"
              ItemsSource="{Binding RootItems}"
              Background="Transparent"
              BorderThickness="0"
              Padding="4"
              Focusable="False"
              VirtualizingStackPanel.IsVirtualizing="True"
              VirtualizingStackPanel.VirtualizationMode="Recycling"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

    <!-- Invalid JSON message -->
    <TextBlock Text="Document is not valid JSON"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,30,0,0"
               Foreground="{DynamicResource LabelTextBrush}"
               FontSize="26.667" FontStyle="Italic" Opacity="0.8" FontFamily="Segoe UI"
               Visibility="{Binding IsJsonValid, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsJsonValid}" Value="False">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </Grid>
</UserControl>
