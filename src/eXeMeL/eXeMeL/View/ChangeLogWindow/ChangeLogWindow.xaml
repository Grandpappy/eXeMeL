<ui:FluentWindow
  x:Class="eXeMeL.View.ChangeLog.ChangeLogWindow"
  xmlns:local="clr-namespace:eXeMeL.View.ChangeLog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Name="ControlRoot"
  ResizeMode="CanResize"
  ShowInTaskbar="False"
  Title="Change Log"
  Height="500"
  Width="600"
  WindowStartupLocation="CenterOwner"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  >

  <Window.Resources>
    <ResourceDictionary>
      <DataTemplate DataType="{x:Type local:ChangeLogHeader}">
        <TextBlock Text="{Binding Text, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,10"/>
      </DataTemplate>

      <DataTemplate DataType="{x:Type local:ChangeLogContent}">
        <TextBlock
          Text="{Binding Text, Mode=OneWay}"
          Margin="20,5,10,0"
          HorizontalAlignment="Stretch"
          TextWrapping="Wrap"
          FontSize="14"
          Opacity="0.8"
          />
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Change Log"/>

    <ScrollViewer Grid.Row="1" Margin="16,0">
      <ItemsControl
        ItemsSource="{Binding Entries, ElementName=ControlRoot}"
        />
    </ScrollViewer>

    <ui:Button x:Name="CloseButton" Grid.Row="2" Content="Close"
               HorizontalAlignment="Center" Margin="8,8,8,16"
               Click="CloseButton_Click" Appearance="Primary"
               MinWidth="100"/>
  </Grid>
</ui:FluentWindow>
