<ui:FluentWindow
  x:Class="eXeMeL.View.ChangeLog.ChangeLogWindow"
  xmlns:local="clr-namespace:eXeMeL.View.ChangeLog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Name="ControlRoot"
  ResizeMode="CanResize"
  ShowInTaskbar="False"
  Title="Change Log"
  Height="500"
  Width="600"
  WindowStartupLocation="CenterOwner"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  Background="Transparent"
  >

  <ui:FluentWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Resources/CommonStyles.xaml"/>
        <ResourceDictionary Source="../../Resources/Icons.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate DataType="{x:Type local:ChangeLogHeader}">
        <TextBlock Text="{Binding Text, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource LabelTextBrush}" Margin="0,20,0,8"/>
      </DataTemplate>

      <DataTemplate DataType="{x:Type local:ChangeLogContent}">
        <TextBlock
          Text="{Binding Text, Mode=OneWay}"
          Margin="16,4,12,0"
          TextWrapping="Wrap"
          FontSize="14"
          Foreground="{DynamicResource BlackBrush}"
          Opacity="0.8"
          />
      </DataTemplate>

    </ResourceDictionary>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      Title="Change Log"
      />

    <ScrollViewer
      Grid.Row="1"
      Margin="16,0"
      >
      <ItemsControl
        ItemsSource="{Binding Entries, ElementName=ControlRoot}"
        Margin="0"
        />
    </ScrollViewer>


    <Border Grid.Row="2" Padding="16,12">
      <ui:Button x:Name="CloseButton" Content="Close" HorizontalAlignment="Center" Width="120" Click="CloseButton_Click" Appearance="Primary"/>
    </Border>
  </Grid>
</ui:FluentWindow>
