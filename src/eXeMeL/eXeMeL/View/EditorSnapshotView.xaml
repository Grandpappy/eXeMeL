<UserControl x:Class="eXeMeL.View.EditorSnapshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:eXeMeL.ViewModel"
             mc:Ignorable="d"
             Name="ControlRoot"
             d:DesignHeight="36" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel, IsDesignTimeCreatable=True}"
      >

  <!-- Entire control hidden when only 1 snapshot (the default) -->
  <UserControl.Style>
    <Style TargetType="UserControl">
      <Setter Property="Visibility" Value="Visible"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Snapshots.Count}" Value="1">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Style>

  <Border Padding="12,4,12,4"
          BorderThickness="0,0,0,1"
          BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Label -->
      <TextBlock Grid.Column="0" Text="Snapshots:" FontSize="12" FontWeight="SemiBold"
                 Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0"/>

      <!-- Snapshot list -->
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Snapshots}"
                    VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button
              Command="{Binding DataContext.ChangeToSnapshotCommand, ElementName=ControlRoot}"
              CommandParameter="{Binding}"
              Content="{Binding Identifier}"
              MinWidth="28" Height="24"
              Padding="8,2" Margin="0,0,4,0"
              FontSize="12"
              Focusable="False">
              <Button.ToolTip>
                <TextBlock Text="Go to this snapshot"/>
              </Button.ToolTip>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Add snapshot button -->
      <ui:Button Grid.Column="2"
                 Appearance="Transparent"
                 Icon="{ui:SymbolIcon Add24}"
                 Command="{Binding CreateSnapshotCommand}"
                 ToolTip="Add a new snapshot"
                 Focusable="False"
                 Padding="4" FontSize="14"/>
    </Grid>
  </Border>
</UserControl>
