<UserControl x:Class="eXeMeL.View.ColorPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="250" d:DesignHeight="40">

  <!-- A compact color swatch button that opens a popup picker -->
  <StackPanel Orientation="Horizontal">
    <Button x:Name="ColorSwatchButton" Width="32" Height="28"
            Padding="0" Click="ColorSwatchButton_Click"
            BorderThickness="1" Cursor="Hand">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ColorSwatch" CornerRadius="4"
                  Background="{TemplateBinding Background}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        </ControlTemplate>
      </Button.Template>
    </Button>

    <TextBlock x:Name="HexLabel" VerticalAlignment="Center"
               Margin="8,0,0,0" FontSize="12" Opacity="0.6"/>

    <!-- Popup with color picker -->
    <Popup x:Name="PickerPopup" StaysOpen="False"
           Placement="Bottom" PlacementTarget="{Binding ElementName=ColorSwatchButton}"
           AllowsTransparency="True">
      <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="12"
              Margin="0,4,0,0">
        <StackPanel Width="280">
          <!-- Swatches -->
          <WrapPanel x:Name="SwatchPanel" Margin="0,0,0,8"/>

          <!-- HSV Sliders -->
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="H" FontSize="11" Opacity="0.5" Width="16" VerticalAlignment="Center"/>
            <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Width="180"
                    Value="210" ValueChanged="HsvSlider_ValueChanged" Margin="0,0,8,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="S" FontSize="11" Opacity="0.5" Width="16" VerticalAlignment="Center"/>
            <Slider x:Name="SatSlider" Minimum="0" Maximum="100" Width="180"
                    Value="60" ValueChanged="HsvSlider_ValueChanged" Margin="0,0,8,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="V" FontSize="11" Opacity="0.5" Width="16" VerticalAlignment="Center"/>
            <Slider x:Name="ValSlider" Minimum="0" Maximum="100" Width="180"
                    Value="80" ValueChanged="HsvSlider_ValueChanged" Margin="0,0,8,0"/>
          </StackPanel>

          <!-- Hex input + preview -->
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBox x:Name="HexInput" Width="80" FontSize="11"
                     Text="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=LostFocus}"/>
            <Border x:Name="PreviewSwatch" Width="24" Height="24" Margin="8,0,0,0"
                    CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </StackPanel>
</UserControl>
