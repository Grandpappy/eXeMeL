<UserControl x:Class="eXeMeL.View.EditorFindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" >

  <UserControl.InputBindings>
    <KeyBinding Key="F3" Command="{Binding FindViewModel.FindNextCommand}"/>
    <KeyBinding Modifiers="Shift" Key="F3" Command="{Binding FindViewModel.FindPreviousCommand}"/>
    <KeyBinding Key="Escape" Command="{Binding FindViewModel.CancelSearchCommand}"/>
  </UserControl.InputBindings>

  <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
    <ui:TextBox
      x:Name="FindSearchText"
      PlaceholderText="Find..."
      ClearButtonEnabled="True"
      Text="{Binding FindViewModel.SearchText, Delay=0, UpdateSourceTrigger=PropertyChanged}"
      Width="220"
      Margin="0,0,2,0"
      FontSize="12"
      PreviewKeyDown="FindSearchText_PreviewKeyDown"
      IsTabStop="False"
      GotFocus="FindSearchText_GotFocus"
      />

    <!-- Next/Prev arrows — hidden until there's search text -->
    <ui:Button
      x:Name="FindNextButton"
      Command="{Binding FindViewModel.FindNextCommand}"
      Appearance="Transparent"
      Icon="{ui:SymbolIcon ChevronDown24}"
      ToolTip="Find Next (F3)"
      Padding="4" Margin="0,0,1,0"
      WindowChrome.IsHitTestVisibleInChrome="True">
      <ui:Button.Style>
        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
          <Setter Property="Visibility" Value="Hidden"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding FindViewModel.HasSearchText}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ui:Button.Style>
    </ui:Button>

    <ui:Button
      x:Name="FindPreviousButton"
      Command="{Binding FindViewModel.FindPreviousCommand}"
      Appearance="Transparent"
      Icon="{ui:SymbolIcon ChevronUp24}"
      ToolTip="Find Previous (Shift+F3)"
      Padding="4"
      WindowChrome.IsHitTestVisibleInChrome="True">
      <ui:Button.Style>
        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
          <Setter Property="Visibility" Value="Hidden"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding FindViewModel.HasSearchText}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ui:Button.Style>
    </ui:Button>
  </StackPanel>
</UserControl>
