    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\SolarizedLightYaml.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.SolarizedLightYaml.xshd</LogicalName>
