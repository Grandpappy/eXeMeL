    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\GitHubLightYaml.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.GitHubLightYaml.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\SolarizedLightXml.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.SolarizedLightXml.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\SolarizedLightJson.xshd">
