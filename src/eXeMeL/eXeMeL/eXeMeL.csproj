<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>eXeMeL</RootNamespace>
    <AssemblyName>eXeMeL</AssemblyName>
    <ApplicationIcon>Assets\eXeMeL Icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- Single-file self-contained publish settings -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.77" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
  </ItemGroup>

  <!-- Syntax highlighting schemes as embedded resources with explicit logical names
       to preserve the resource names that SyntaxHighlightingManager expects -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\Bright.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.Bright.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\Earthy.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.Earthy.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\Dark.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.Dark.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\VSBlue.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.VSBlue.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\SolarizedDark.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.SolarizedDark.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\JsonBright.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.JsonBright.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\JsonEarthy.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.JsonEarthy.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\JsonDark.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.JsonDark.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\JsonVSBlue.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.JsonVSBlue.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\SyntaxHighlightingSchemes\JsonSolarizedDark.xshd">
      <LogicalName>eXeMeL.Assets.SyntaxHighlightingSchemes.JsonSolarizedDark.xshd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\ChangeLog.txt">
      <LogicalName>eXeMeL.Assets.ChangeLog.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Theme color dictionaries must be Resource (not Page) to support pack:// URI loading -->
  <ItemGroup>
    <Resource Include="Resources\DarkThemeColors.xaml" />
    <Resource Include="Resources\ThemeColors.xaml" />
    <Resource Include="Resources\SolarizedDarkThemeColors.xaml" />
    <!-- Prevent SDK auto-including these as Page (since they're explicitly Resource) -->
    <Page Remove="Resources\DarkThemeColors.xaml" />
    <Page Remove="Resources\ThemeColors.xaml" />
    <Page Remove="Resources\SolarizedDarkThemeColors.xaml" />
  </ItemGroup>

  <!-- Icon resources -->
  <ItemGroup>
    <Resource Include="Assets\eXeMeL Icon.ico" />
    <Content Include="Assets\FileIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="eXeMeL.Tests" />
  </ItemGroup>

</Project>
