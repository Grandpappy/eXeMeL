<SyntaxDefinition name="JSON" extensions=".json" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="PropertyKey" foreground="DarkMagenta" />
  <Color name="StringValue" foreground="Blue" />
  <Color name="Number" foreground="DarkCyan" />
  <Color name="Keywords" foreground="DarkBlue" fontWeight="bold" />
  <Color name="Punctuation" foreground="#333333" />

  <RuleSet>
    <Rule color="PropertyKey">"[^"\\]*(?:\\.[^"\\]*)*"\s*(?=:)</Rule>
    <Span color="StringValue">
      <Begin>"</Begin>
      <End>"|$</End>
      <RuleSet>
        <Rule color="StringValue">\\.</Rule>
      </RuleSet>
    </Span>
    <Rule color="Number">-?\b\d+(\.\d+)?([eE][+-]?\d+)?\b</Rule>
    <Rule color="Keywords">\b(true|false|null)\b</Rule>
    <Rule color="Punctuation">[{}\[\]:,]</Rule>
  </RuleSet>
</SyntaxDefinition>
