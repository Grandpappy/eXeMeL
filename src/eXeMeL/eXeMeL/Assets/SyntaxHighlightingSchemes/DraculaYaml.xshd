<SyntaxDefinition name="YAML" extensions=".yaml;.yml" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6272a4" />
  <Color name="Key" foreground="#8be9fd" />
  <Color name="StringValue" foreground="#f1fa8c" />
  <Color name="Number" foreground="#bd93f9" />
  <Color name="Keywords" foreground="#ff79c6" />
  <Color name="DocumentMarker" foreground="#ff79c6" fontWeight="bold" />
  <Color name="Anchor" foreground="#f8f8f2" />
  <Color name="Punctuation" foreground="#f8f8f2" />
  <RuleSet>
    <Rule color="Comment">\#.*$</Rule>
    <Rule color="DocumentMarker">^---\s*$</Rule>
    <Rule color="DocumentMarker">^\.\.\.\s*$</Rule>
    <Rule color="Anchor">[&amp;*]\w+</Rule>
    <Rule color="Key">^[\s]*[\w][\w.\-/]*(?=\s*:)</Rule>
    <Span color="StringValue"><Begin>"</Begin><End>"|$</End><RuleSet><Rule color="StringValue">\\.</Rule></RuleSet></Span>
    <Span color="StringValue"><Begin>'</Begin><End>'|$</End></Span>
    <Rule color="Number">(?&lt;=:\s)-?\b\d+(\.\d+)?([eE][+-]?\d+)?\b</Rule>
    <Rule color="Keywords">(?&lt;=:\s)\b(true|false|null|yes|no|on|off)\b</Rule>
    <Rule color="Punctuation">[-:&gt;|]</Rule>
  </RuleSet>
</SyntaxDefinition>
